# SQLite database (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Always open the app at this exact origin (Spotify forbids "localhost").
APP_URL=http://127.0.0.1:3000

# 32-byte hex key for encrypting OAuth tokens at rest: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Spotify — https://developer.spotify.com/dashboard
# Redirect URI: http://127.0.0.1:3000/api/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Google/YouTube — https://console.cloud.google.com (enable "YouTube Data API v3")
# Redirect URI: http://127.0.0.1:3000/api/auth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TIDAL — https://developer.tidal.com/dashboard
# Redirect URI: http://127.0.0.1:3000/api/auth/tidal/callback
# TIDAL is a PKCE public client: no secret is sent even if you set one.
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
